# Copy this file to `.env` and adjust the values before running `docker compose up -d`.

# Host port to expose the MCP service on.
LARK_MCP_PORT=3000

# App ID allowlist (comma or space separated). Leave empty to accept any App ID.
# Strongly recommended in production.
LARK_ALLOW_APP_IDS=

# Service-level access token allowlist (comma or space separated). Leave empty to
# disable auth. When set, clients must send one of these in the X-Mcp-Access-Token header.
LARK_SERVER_ACCESS_TOKENS=

# Default tools to enable. Clients can override per request.
LARK_TOOLS=preset.default

# Default API domain. Lark international: https://open.larksuite.com
LARK_DOMAIN=https://open.feishu.cn

# Default token mode: auto | user_access_token | tenant_access_token
LARK_TOKEN_MODE=auto

# Ignore VCS
.git
.gitignore

# Dependencies and yarn berry cache (installed inside the image, not copied)
node_modules
.yarn
.pnp.*

# Coverage output (build artifact `dist` is kept: it is copied into the image)
coverage

# Deployment / local env
.env
docker-compose.yml
*.iml

# Logs and caches
npm-debug.log*
yarn-error.log*
**/.DS_Store
**/.vscode
**/.idea
**/tmp
**/.cache

